<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests of the sender library as a plain console runner (no test framework
    package). Run: dotnet run -c Release, optionally followed by a name filter
    and the word realtime for the wall-clock pacing test. Exit code 0 = all passed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NauticPinnace.N2kUpdate.Tests</RootNamespace>
    <AssemblyName>NauticPinnace.N2kUpdate.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\NauticPinnace.N2kUpdate\NauticPinnace.N2kUpdate.csproj" />
    <ProjectReference Include="..\..\src\NauticPinnace.N2kUpdate.Testing\NauticPinnace.N2kUpdate.Testing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Shared\WindowsHostTiming.cs" Link="Shared\WindowsHostTiming.cs" />
  </ItemGroup>
</Project>
